# ---------------------------------------------------------------------------
# LLM configuration (OPTIONAL)
# The tool works fully without an LLM via deterministic templates.
# Providing a key enables AI-assisted copy generation.
# Both Google Gemini and any OpenAI-compatible endpoints are supported.
# ---------------------------------------------------------------------------

# Option A: Google Gemini (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Option B: Primary OpenAI / Local LLM / Other provider
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Option C: Optional Fallback provider (OpenAI-compatible)
# Invoked if primary fails after 1 retry on 429/5xx/timeout/network error, or immediately on 401/403
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1

