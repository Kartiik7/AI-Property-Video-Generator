# ---------------------------------------------------------------------------
# LLM configuration (OPTIONAL)
# The tool works fully without an LLM via deterministic templates.
# Providing a key enables AI-assisted copy generation.
# Both Google Gemini and any OpenAI-compatible endpoints are supported.
# ---------------------------------------------------------------------------

# Option A: Google Gemini (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Option B: Primary OpenAI / Local LLM / Other provider
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Option C: Optional Fallback provider (OpenAI-compatible)
# Invoked if primary fails after 1 retry on 429/5xx/timeout/network error, or immediately on 401/403
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# TTS (Text-to-Speech) configuration (OPTIONAL)
# Controls which TTS engine narrates the video voiceover.
# ---------------------------------------------------------------------------

# TTS provider: auto | gemini | edge  (default: auto)
#   auto  — uses Gemini if GEMINI_API_KEY exists, otherwise falls back to edge-tts
#   gemini — always use Google Gemini TTS (requires GEMINI_API_KEY or compatible LLM key)
#   edge   — always use Microsoft edge-tts (free, offline-capable)
# TTS_PROVIDER=auto

# Gemini TTS model (default: gemini-3.8-flash-lite-tts)
# TTS_GEMINI_MODEL=gemini-3.8-flash-lite-tts

# Gemini TTS voice (default: Kore)
# See https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash-lite-tts for voice list
# TTS_GEMINI_VOICE=Kore

# Gemini API key for TTS (defaults to GEMINI_API_KEY above).
# If GEMINI_API_KEY is absent, reuses LLM_API_KEY when LLM_BASE_URL contains
# generativelanguage.googleapis.com (i.e. you are already using Gemini as your LLM).
# GEMINI_API_KEY=  (set above in LLM section)
